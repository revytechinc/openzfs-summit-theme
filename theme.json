{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Background", "color": "#f8fafc" },
				{ "slug": "surface", "name": "Surface", "color": "#ffffff" },
				{ "slug": "contrast", "name": "Text", "color": "#0f172a" },
				{ "slug": "muted", "name": "Muted text", "color": "#475569" },
				{ "slug": "border", "name": "Border", "color": "#cbd5e1" },
				{ "slug": "accent", "name": "Accent", "color": "#206674" },
				{ "slug": "accent-hover", "name": "Accent hover", "color": "#174d58" },
				{ "slug": "on-accent", "name": "Text on accent", "color": "#ffffff" },
				{ "slug": "accent-soft", "name": "Accent tint", "color": "#e3f2ef" },
				{ "slug": "highlight", "name": "Highlight", "color": "#b45309" },
				{ "slug": "logo-tile", "name": "Logo tile", "color": "#ffffff" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-var.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2rem", "fluid": { "min": "1.625rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "3.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 5rem)" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "card", "name": "Card", "shadow": "0 1px 2px rgb(15 23 42 / 6%), 0 4px 16px rgb(15 23 42 / 6%)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2rem)",
				"right": "clamp(1rem, 4vw, 2rem)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent-hover)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "fontWeight": "700", "lineHeight": "1.2", "letterSpacing": "-0.015em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.15", "fontWeight": "800" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.25" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.3" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--on-accent)"
				},
				"border": { "radius": "10px" },
				"typography": { "fontWeight": "700", "fontSize": "1rem" },
				"spacing": { "padding": { "top": "0.7rem", "bottom": "0.7rem", "left": "1.3rem", "right": "1.3rem" } },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-hover)",
						"text": "var(--wp--preset--color--on-accent)"
					}
				},
				":focus": {
					"outline": { "color": "var(--wp--preset--color--accent)", "offset": "3px", "style": "solid", "width": "2px" }
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontWeight": "600", "fontSize": "0.95rem" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/site-title": {
				"typography": { "fontWeight": "700" },
				"elements": { "link": { "typography": { "textDecoration": "none" }, "color": { "text": "var(--wp--preset--color--contrast)" } } }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" }
			},
			"core/table": {
				"border": { "color": "var(--wp--preset--color--border)" }
			},
			"core/code": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)" },
				"color": { "background": "var(--wp--preset--color--surface)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-with-title", "title": "Page with title", "postTypes": [ "page" ] },
		{ "name": "page-wide", "title": "Page (wide, no title)", "postTypes": [ "page" ] }
	]
}
